<?xml version="1.0" encoding="utf-8"?>
<paths xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Only what may be handed to another app: the app's own trash copies and copies made for
         sending. Never the vault (encrypted, shown through its own provider) or other private files. -->
    <files-path name="trash_files" path="trash/" />
    <cache-path name="shared_cache" path="shared_media/" />
    <!-- Copies without location made for sending -->
    <cache-path name="share" path="share/" />
</paths>
